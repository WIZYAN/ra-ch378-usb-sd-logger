/************************数据接收中断函数*************************/
void hmi_uart_IRQHandler(void)
{
    uint16_t i;

    if(hmi_rx_len<5)
    {
        hmi_uart_init();
    }
    else
    {
        for(i=0;i<hmi_rx_len;i++)
        {
            queue_push(HMI_rxChar[i]);//入队
        }
    }
    memset(HMI_rxChar,0,sizeof(HMI_rxChar));
    hmi_rx_len=0;
}
