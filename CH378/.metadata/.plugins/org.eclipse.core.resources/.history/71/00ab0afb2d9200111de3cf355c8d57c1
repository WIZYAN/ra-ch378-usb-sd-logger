void BatchSetTextFloat(int control_id,double value,int Digits)
{
    uint16_t  i = 0, length = 0;
    uint32_t  data;
    double     data1;

    TX_16(control_id);
    data1 = value;
    if(value < 0)
    {
        value = -value;
    }
    value *= (float)pow(10, Digits);
    data = (uint32_t)(int32_t)value;

    if(data == 0)
        length = 1;
    else
    {
        while(data)
        {
            data /= 10;
            length++;
        }
    }
    data = (uint32_t)(int32_t)value;
    if(length > Digits)
    {
        if(data1<0)
        {
                TX_16(length + 2);
                TX_8(0x2D);
        }
        else
        {
                TX_16(length + 1);
        }
        for(i = 0; i < length + 1; i++)
        {
            if(i < (length - Digits))
            {
                TX_8(0x30 | (uint8_t)(uint32_t)((data / (uint32_t)pow(10, length - i - 1)) % 10));
            }
            else  if(i == (length - Digits))
                TX_8(0x2e);
            else
            {
                TX_8(0x30 | (uint8_t)(uint32_t)((data / (uint32_t)pow(10, length - i)) % 10));
            }
        }
    }
    else
    {
        if(data1<0)
        {
                TX_16(Digits + 3);
                TX_8(0x2D);
        }
        else
        {
                TX_16(Digits + 2);
        }
        for(i = 0; i < Digits + 2; i++)
        {
            if(i == 0)          TX_8(0x30);
            else  if(i == 1)    TX_8(0x2e);
            else                TX_8(0x30 | (uint8_t)(uint32_t)((data / (uint32_t)pow(10, Digits + 1 - i)) % 10));
        }
    }
}


