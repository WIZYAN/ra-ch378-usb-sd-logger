#define TX_8(P1) SEND_DATA((uint8_t)((P1)&0xFF))  //发送单个字节
#define TX_8N(P,N) SendNuint8_t((uint8_t *)P,N)  //发送N个字节
#define TX_16(P1) TX_8((P1)>>8);TX_8(P1)  //发送16位整数
#define TX_16N(P,N) SendNuint16_t((uint16_t *)P,N)  //发送N个16位整数
#define TX_32(P1) TX_16((P1)>>16);TX_16((P1)&0xFFFF)  //发送32位整数

void SendChar(uint8_t t)
{
    uint16_t i=60000;
    hmi_tx_flag = 0;
    hmi_send_one_char(t);
    while (!hmi_tx_flag)
    {
        i--;
        if(i==0)
            break;
    }
    //vTaskDelay(1);
}

static uint8_t dec_to_hex(uint8_t num)  //num=21
{
    uint8_t hex_num, shi, ge;

    shi = num / 10;
    ge = num % 10;

    shi = (uint8_t)((shi & 0x0f) << 4);
    ge = ge & 0x0f;

    hex_num = shi | ge;

    return hex_num;
}

#if(CRC16_ENABLE)

static uint16_t _crc16 = 0xffff;
static void AddCRC16(uint8_t *buffer,uint16_t n,uint16_t *pcrc)
{
    uint16_t i,j,carry_flag,a;

    for (i=0; i<n; i++)
    {
        *pcrc=*pcrc^buffer[i];
        for (j=0; j<8; j++)
        {
            a=*pcrc;
            carry_flag=a&0x0001;
            *pcrc=*pcrc>>1;
            if (carry_flag==1)
                *pcrc=*pcrc^0xa001;
        }
    }
}

uint16_t CheckCRC16(uint8_t *buffer,uint16_t n)
{
    uint16_t crc0 = 0x0;
    uint16_t crc1 = 0xffff;

    if(n>=2)
    {
        crc0 = ((buffer[n-2]<<8)|buffer[n-1]);
        AddCRC16(buffer,n-2,&crc1);
    }

    return (crc0==crc1);
}

void SEND_DATA(uint8_t c)
{
    AddCRC16(&c,1,&_crc16);
    SendChar(c);
}

void BEGIN_CMD()
{
    TX_8(0XEE);
    _crc16 = 0XFFFF;//开始计算CRC16
}

void END_CMD()
{
    uint16_t crc16 = _crc16;
    TX_16(crc16);//发送CRC16
    TX_32(0XFFFCFFFF);
}

#else//NO CRC16

#define SEND_DATA(P) SendChar(P)
#define BEGIN_CMD() TX_8(0XEE)
#define END_CMD() TX_32(0XFFFCFFFF)

#endif

void DelayMS(unsigned int n)
{
    uint32_t i,j;
    for(i = n;i>0;i--)
        for(j=1000;j>0;j--) ;
}

static void SendStrings(uint8_t *str)
{
    while(*str)
    {
        TX_8(*str);
        str++;
    }
}

static void SendNuint8_t(uint8_t *pData,uint16_t nDataLen)
{
    uint16_t i = 0;

    for (;i<nDataLen;++i)
    {
        TX_8(pData[i]);
    }
}

static void SendNuint16_t(uint16_t *pData,uint16_t nDataLen)
{
    uint16_t i = 0;

    for (;i<nDataLen;++i)
    {
        TX_16(pData[i]);
    }
}

