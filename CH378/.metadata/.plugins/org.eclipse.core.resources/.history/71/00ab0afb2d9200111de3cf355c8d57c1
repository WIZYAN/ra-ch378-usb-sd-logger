void uart3_dis_callback(uart_callback_args_t *p_args)
{
    /* TODO: add your own code here */
    switch (p_args->event)
   {
       case UART_EVENT_TX_COMPLETE:
       {
           hmi_tx_flag = 1;
       }
       break;

       case UART_EVENT_RX_CHAR:
       {
           HMI_rxChar[hmi_rx_len++] = (uint8_t)(p_args->data);
           if(hmi_rx_len > QUEUE_MAX_SIZE)
               hmi_rx_len = QUEUE_MAX_SIZE;
           hmi_rx_flag = 0;
       }
       break;
       case UART_EVENT_RX_COMPLETE:  // 暂时无用，触发不了
       {
          ;
       }
       break;
       default: break;
   }
}

