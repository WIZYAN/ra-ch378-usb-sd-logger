/*
 * 说明：串口屏收到的数据处理
 * 输入：无
 * 输出：是否有控件操作
 */
uint8_t ProcessMessage(PCTRL_MSG msg)
{
    uint8_t control_operation = 0;

    uint8_t cmd_type = msg->cmd_type;//指令类型
//    uint8_t ctrl_msg = msg->ctrl_msg;   //消息的类型
    uint8_t control_type = msg->control_type;//控件类型
//    uint16_t screen_id = PTR2uint16_t(&msg->screen_id);//画面ID
//    uint16_t control_id = PTR2uint16_t(&msg->control_id);//控件ID
//    uint32_t value = PTR2uint32_t(msg->param);//数值

    //赋值转接
    g_page.cmd_type = msg->cmd_type;                            //指令类型
    g_page.ctrl_msg = msg->ctrl_msg;                            //消息的类型
    g_page.control_type = msg->control_type;                    //控件类型
    g_page.screen_id = PTR2uint16_t(&msg->screen_id);            //画面ID
    g_page.control_id = PTR2uint16_t(&msg->control_id);          //控件ID
    g_page.value =  PTR2uint32_t(msg->param);                   //数值
    g_page.param_addr = msg->param;                             //数组引用

    if(cmd_type == NOTIFY_CONTROL)
    {
        if(control_type == kCtrlButton || control_type == kCtrlText  || control_type == kCtrlMenu)//按钮，文本，菜单
            control_operation = 1;
    }

    if(msg->ctrl_msg == MSG_GET_CARTOON)
    {
        control_operation = 1;
    }

    switch(cmd_type)
    {
    case NOTIFY_READ_RTC://读取RTC时间
        NotifyReadRTC(cmd_buffer[2],cmd_buffer[3],cmd_buffer[4],cmd_buffer[5],cmd_buffer[6],cmd_buffer[7],cmd_buffer[8]);
        break;

    default:
        break;
    }

    return control_operation;
}

