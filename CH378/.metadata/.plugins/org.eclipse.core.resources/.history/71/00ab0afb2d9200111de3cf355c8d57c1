/*!
 *  \brief  读取RTC时间，注意返回的是BCD码
 *  \param  year        年（BCD）
 *  \param  month       月（BCD）
 *  \param  week        星期（BCD）
 *  \param  day         日（BCD）
 *  \param  hour        时（BCD）
 *  \param  minute  分（BCD）
 *  \param  second  秒（BCD）
 */
__WEAK void NotifyReadRTC(uint8_t year,uint8_t month,uint8_t week,uint8_t day,uint8_t hour,uint8_t minute,uint8_t second)
{
    g_hmi.para.hmi_time.year = (uint8_t)((year>>4)*10 + (year&0x0F));
    g_hmi.para.hmi_time.month = (uint8_t)((month>>4)*10 + (month&0x0F));
    g_hmi.para.hmi_time.week = (uint8_t)week;
    g_hmi.para.hmi_time.date = (uint8_t)((day>>4)*10 + (day&0x0F));
    g_hmi.para.hmi_time.hour = (uint8_t)((hour>>4)*10 + (hour&0x0F));
    g_hmi.para.hmi_time.min = (uint8_t)((minute>>4)*10 + (minute&0x0F));
    g_hmi.para.hmi_time.sec = (uint8_t)((second>>4)*10 + (second&0x0F));
}

