static void H_O_Analysis_inf(PAGE_CONTROL *page_control)
{
    int value, i = 0, val_temp = 0;
    uint16_t Len = 0;
    char data[14] = { 0 };
    double fvalue;
    uint16_t screen_id_temp = PAGE_Analysis_inf;
    uint8_t *p = page_control->param_addr;

    sscanf ((const char*) page_control->param_addr, "%d", &value);
    Len = (uint16_t) GetStringLen (page_control->param_addr);
    for (i = 0; i < Len; i++)
    {
        data[i] = (char) *p;
        p++;
    }
    if (14 - Len > 0)
    {
        for (; i < 14; i++)
            data[i] = 0;
    }
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == 7)//运行时间
        {
            g_menu.runtime = (uint32_t) value;
            val_temp = App_Sensor_Work_Time_Count ();
            if (value >= val_temp)
                value = val_temp - 1;
            g_life.main.save.now_limit_use_time = (int) value;
        }
        else if (page_control->control_id == 1)
        {
            if(data[0] == 0)
            {
                BatchBegin (screen_id_temp);
                BatchSetText (1, (uint8_t*) g_hmi.save.num_model);    //仪器型号
                BatchEnd ();
            }
            else
            {
                for (i = 0; i < 14; i++)
                {
                    g_hmi.save.num_model[i] = (uint8_t) data[i];
                }
            }
        }
        else if (page_control->control_id == 2)
        {
            if(data[0] == 0)
            {
                BatchBegin (screen_id_temp);
                BatchSetText (2, (uint8_t*) g_hmi.save.num_series);   //整机编号
                BatchEnd ();
            }
            else
            {
                for (i = 0; i < 14; i++)
                {
                    g_hmi.save.num_series[i] = (uint8_t) data[i];
                }
            }
        }
    }

    //范围
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        fvalue = (double) atof ((const char*) page_control->param_addr);
        if (fvalue > 0)
            fvalue += 0.0001f;    //字符串转float
        else if (fvalue < 0)
            fvalue -= 0.0001f;    //字符串转float

        if (page_control->control_id == 38)
        {
            if (fvalue  < *g_var_temp.fac_dis.pointer_low || fvalue < 0 || fvalue >= 1000000)
                App_Menu_Page_Sw (PAGE_Set_Error);
            else
                (*g_var_temp.fac_dis.pointer_upp) = fvalue;
            BatchBegin (screen_id_temp);
            BatchSetTextDouble (38, (double) *g_var_temp.fac_dis.pointer_upp ,  g_var_temp.val_digits);
            BatchSetTextDouble (39, (double) *g_var_temp.fac_dis.pointer_low ,  g_var_temp.val_digits);
            BatchEnd ();
        }
        else if (page_control->control_id == 39)
        {
            if (fvalue  > *g_var_temp.fac_dis.pointer_upp || fvalue < 0 || fvalue >= 1000000 )
                App_Menu_Page_Sw (PAGE_Set_Error);
            else
                (*g_var_temp.fac_dis.pointer_low) = fvalue ;
            BatchBegin (screen_id_temp);
            BatchSetTextDouble (38, (double) *g_var_temp.fac_dis.pointer_upp ,  g_var_temp.val_digits);
            BatchSetTextDouble (39, (double) *g_var_temp.fac_dis.pointer_low ,  g_var_temp.val_digits);
            BatchEnd ();
        }
    }

    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }

        else if (page_control->control_id == 6)
        {
            App_Menu_Page_Sw (PAGE_FacInitialEnsure);
        }
        else if (page_control->control_id == 34)
        {
            menu_waiting = menu_formating;
            App_Menu_Page_Sw (PAGE_FormatEnsure);
        }
    }
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        sscanf ((const char*) page_control->param_addr, "%d", &value);
        if (page_control->control_id == 8)
        {
            g_db9_modbus.save.fac_code = g_net_modbus.save.fac_code = g_modbus.save.fac_code = (uint16_t) value;
        }
        else if (page_control->control_id == 5)
        {
            g_menu.save.heating_time = (uint32_t) value;
        }
    }

    //菜单
    if ((page_control->control_type == kCtrlMenu) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == 333)
        {
            g_menu.save.protocol_sel = *page_control->param_addr;
        }
    }
