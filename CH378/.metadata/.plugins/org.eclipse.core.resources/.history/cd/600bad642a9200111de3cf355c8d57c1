static void H_O_InternetSet(PAGE_CONTROL *page_control)
{
    uint16_t screen_id_temp = PAGE_InternetSet;

    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        int value = 0;
        if (page_control->control_id >= 40 && page_control->control_id <= 52)
        {
            sscanf ((const char*) page_control->param_addr, "%d", &value);
            if (value > 255)
                value = 255;
            if (value < 0)
