/*
 * 名称：状态详情
 * 输入：无
 * 返回：无
 */
static void H_P_dis_status(void)
{
    uint16_t screen_id_temp = PAGE_dis_status;
    uint8_t temp_status;

    BatchBegin (screen_id_temp);
    BatchSetTextFloat (21, (float) g_ms5607_data_air.i_Temperature / 100, 1);
    BatchSetTextFloat (20, (float) g_ms5607_data_air.i_Pressure / 1000, 1);
    BatchSetTextInt32(29, (int32_t) g_sensor_o2.data_para.lock_count);
    BatchEnd ();

    //状态
    BatchBegin (screen_id_temp);
    if (g_hmi.para.status_main_page)    //整机状态报警
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (16, temp_status);    //状态报警
    if (g_alarm[1].run_para.ala_sta)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (15, temp_status);    //浓度报警1
    if (g_alarm[2].run_para.ala_sta)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (18, temp_status);    //浓度报警2
    if (g_alarm[0].run_para.ala_sta)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (37, temp_status);    //浓度报警3

    if (g_save_data_app.history_data.chip_ready)
        temp_status = 0;
    else
        temp_status = 1;
    BatchSetFrame (13, temp_status);    //存储

    if (g_flow.para.flow_alarm_status)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (9, temp_status);    //流量报警

    if (g_flow.para.pressure_alarm_status)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (7, temp_status);    //压力报警

    if (g_flow.para.flow_control_err)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (1, temp_status);    //流量控制错误

    if (*g_var_temp.sensor.pointer_comm_status)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (3, temp_status);    //传感器通讯

    if (*g_var_temp.sensor.pointer_comm_status)    //微量氧需要加入传感器压力保护状态
        temp_status = 1;
    else
        temp_status = 0;

    BatchSetFrame (11, temp_status);    //传感器状态

    if (g_life.main.para.limit_time_nearly_run_out_flag)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (6, temp_status);    //试用功能状态

    if (g_hmi.para.conc_pro_state)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (59, temp_status);    //传感器浓度保护

    if (g_alarm[3].run_para.ala_sta)
        temp_status = 1;
    else
        temp_status = 0;
    BatchSetFrame (55, temp_status);    //传感器压力保护
    BatchEnd ();
}

