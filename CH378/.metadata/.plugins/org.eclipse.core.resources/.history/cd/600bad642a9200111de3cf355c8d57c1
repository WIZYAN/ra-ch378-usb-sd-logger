static void H_P_Authority_Set_Page(void)
{
    ;
}

static void H_O_Authority_Set_Page(PAGE_CONTROL *page_control)
{
    uint16_t screen_id_temp = PAGE_Authority_Set;
    int value, i = 0;
    uint16_t Len = 0;
    char data[21] ={ 0 };
    uint8_t *p = page_control->param_addr;

    sscanf ((const char*) page_control->param_addr, "%d", &value);
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == 1)
        {
            g_life.main.save.limit_class[0].limit_time = (uint16_t) value;
        }
        else if (page_control->control_id == 2)
        {
            g_life.main.save.limit_class[1].limit_time = (uint16_t) value;
        }
        else if (page_control->control_id == 3)
        {
            g_life.main.save.limit_class[2].limit_time = (uint16_t) value;
        }
        else if (page_control->control_id == 4)
        {
            g_life.main.save.limit_class[3].limit_time = (uint16_t) value;
        }
        else if (page_control->control_id >= 50)
        {
            Len = (uint16_t) GetStringLen (page_control->param_addr);
            for (i = 0; i < Len; i++)
            {
                data[i] = (char) *p;
                p++;
            }
            if (21 - Len > 0)
            {
                for (; i < 21; i++)
                    data[i] = 0;
            }
            for (i = 0; i < 21; i++)
            {
                g_life.main.save.phone_num[i] = (uint8_t) data[i];
            }
        }
        else if (page_control->control_id >= 5 && page_control->control_id <= 8)
        {
            Len = (uint16_t) GetStringLen (page_control->param_addr);
            for (i = 0; i < Len; i++)
            {
                data[i] = (char) *p;
                p++;
            }
            if (11 - Len > 0)
            {
                for (; i < 21; i++)
                    data[i] = 0;
            }
            if(data[0] == 0)//防止输入为空
            {
                H_F_Authority_Set_Page();
            }
            else
            {
                for (i = 0; i < 11; i++)
                {
                    g_life.main.save.limit_class[page_control->control_id - 5].limit_password[i] = (uint8_t) data[i];
                }
            }

        }
    }
    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }
        else if (page_control->control_id == 10)
        {
            if (g_life.main.save.main_password_lock_switch)
            {
                g_life.main.save.main_password_lock_switch = 0;
                g_life.main.save.now_limit_time_quantum = 0;
                g_life.main.para.limit_4times_over_flag = 0;
            }
            else
            {
                g_life.main.save.main_password_lock_switch = 1;
            }
            AnimationPlayFrame (screen_id_temp, 14, g_life.main.save.main_password_lock_switch);
        }
    }
}

