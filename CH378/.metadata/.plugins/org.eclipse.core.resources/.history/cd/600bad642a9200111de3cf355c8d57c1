static uint8_t ND_DIS_Change_Micro_ppm(uint16_t screen_id, uint16_t val_id, float val) //浓度显示转换，只用于显示浓度切换
{
    double val_temp_dis = val;

    if (val_temp_dis < 10) //1-10ppm x.xxxppm
    {
        SetTextValueFloat (screen_id, val_id, (float) val_temp_dis, 2); //发送浓度
        return 1;
    }
    else if (val_temp_dis < 100) //10-100ppm xx.xxppm
    {
        SetTextValueFloat (screen_id, val_id, (float) val_temp_dis, 1); //发送浓度
        return 1;
    }
    else if (val_temp_dis < 1000) //100-1000ppm xxx.xppm
    {
        SetTextValueInt32 (screen_id, val_id, (int)val_temp_dis); //发送浓度
        return 1;
    }
    else if (val_temp_dis < 10000) //1000-10000ppm xxxxppm
    {
        SetTextValueInt32 (screen_id, val_id, (int) val_temp_dis);
        return 1;
    }
    else //1%以上
    {
        SetTextValueFloat (screen_id, val_id, (float) val_temp_dis / 10000, 2); //发送浓度
        return 2;
    }
}
