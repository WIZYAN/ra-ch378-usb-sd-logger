            BatchEnd();
        }

        if(page_control->control_id == 40)//看
        {
            //所选用户密码为空则不能
            if(strlen((char*)g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_name) == 0 || strlen((char*)g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_password) == 0)
            {
                App_Menu_Page_Sw(PAGE_Set_Error);
            }
            else
            {
                strcpy((char*)(g_user_manage.para.new_alter_user.user_name),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_name));
                strcpy((char*)(g_user_manage.para.new_alter_user.user_password),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_password));
                strcpy((char*)(g_user_manage.para.new_alter_user.user_root),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_root));
                App_Menu_Page_Sw(PAGE_Add_user_interface);
            }
        }
        else if(page_control->control_id == 41)//改
        {
            //所选用户密码为空则不能
            if(strlen((char*)g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_name) == 0 || strlen((char*)g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_password) == 0)
            {
                App_Menu_Page_Sw(PAGE_Set_Error);
            }
            else
            {
                strcpy((char*)(g_user_manage.para.new_alter_user.user_name),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_name));
                strcpy((char*)(g_user_manage.para.new_alter_user.user_password),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_password));
                strcpy((char*)(g_user_manage.para.new_alter_user.user_root),(char*)(g_user_manage.save.user_list[g_user_manage.para.now_choose_list].user_root));
                App_Menu_Page_Sw(PAGE_Add_user_interface);
            }
        }
        else if(page_control->control_id == 2)//删
        {
            App_Menu_Page_Sw(PAGE_delete_user);
        }
        else if(page_control->control_id == 3)//加
        {
            for(j = 0 ; j < 7; j++)
            {
                if(g_user_manage.save.user_list[j].user_name[0] == 0)
                {
                    g_user_manage.para.now_choose_list = j;
                    break;
                }
            }
            if(j == 7)
            {
                App_Menu_Page_Sw(PAGE_Set_Error);
            }
            else
            {
                App_Menu_Page_Sw(PAGE_Add_user_interface);
            }
            strcpy((char*)(g_user_manage.para.new_alter_user.user_name),"\0");
            strcpy((char*)(g_user_manage.para.new_alter_user.user_password),"\0");
            for(j = 0 ; j < ROOT_NUM; j++)
            {
                g_user_manage.para.new_alter_user.user_root[j] = 0;
            }
        }
        if(page_control->control_id == BUTTON_RETURN)
        {
            g_user_manage.para.now_choose_list = 0;//清除当前选中的用户
            App_Menu_Page_Back();
        }
        else if(page_control->control_id == BUTTON_MAIN)
        {
            g_user_manage.para.now_choose_list = 0;//清除当前选中的用户
            App_Return_Main_Dis();
        }
