static void H_O_Sensor_protect(PAGE_CONTROL *page_control)
{
    uint16_t screen_id_temp = PAGE_Sensor_protect;
    double fval_temp = 0;

    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }
        else if (page_control->control_id == 12)
        {
            if(g_alarm[2].save.alarm_mode == 0)
            {
                g_alarm[2].save.alarm_mode = 1;
            }
            else
            {
                g_alarm[2].save.alarm_mode = 0;
            }
            AnimationPlayFrame (screen_id_temp, 87, g_alarm[2].save.alarm_mode);
        }
        else if (page_control->control_id == 22)
        {
            if(g_alarm[3].save.alarm_mode == 0)
            {
                g_alarm[3].save.alarm_mode = 4;
            }
            else
            {
                g_alarm[3].save.alarm_mode = 0;
            }
            AnimationPlayFrame (screen_id_temp, 20, g_alarm[3].save.alarm_mode);
        }
        else if (page_control->control_id == 49)
        {
            if(g_sensor_o2.save.trend_sw == 0)
            {
                g_sensor_o2.save.trend_sw = 1;
            }
            else
            {
                g_sensor_o2.save.trend_sw = 0;
            }
            AnimationPlayFrame (screen_id_temp, 48 , g_sensor_o2.save.trend_sw);
        }
    }
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        fval_temp = (double) atof ((const char*) page_control->param_addr) + 0.0001f;
        switch (page_control->control_id)
        {
            case 7://浓度保护上限
            {
                if (fval_temp >= 10 && fval_temp < 1000000)
                    g_alarm[2].save.val = fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            }   break;

            case 1://浓度保护延时
            {
                if (fval_temp > 0 && fval_temp <= g_sensor_o2.save.trend_time )
                    g_sensor_o2.save.conc_count_time = (uint16_t) fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            }break;

            case 36:
            {
                if (fval_temp > 0)
                    g_sensor_o2.save.lock_time = (uint16_t) fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            } break;

            case 32://压力保护下限
            {
                if (fval_temp < g_alarm[3].save.scope_upp)
                    g_alarm[3].save.scope_low = (float) fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            } break;

            case 29://压力保护上限
            {
                if (fval_temp > g_alarm[3].save.scope_low)
                    g_alarm[3].save.scope_upp = (float) fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            } break;

            case 53://趋势判断延时
            {
                if (fval_temp > g_sensor_o2.save.conc_count_time)
                    g_sensor_o2.save.trend_time = (uint16_t) fval_temp;
                else
                    App_Menu_Page_Sw (PAGE_Set_Error);
            } break;

            default:
            break;
        }
       // H_F_0303_DoubleO2_Sensor_Para ();
    }
    //B.菜单
    if((page_control->control_type == kCtrlMenu) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == 27)
        {
            g_sensor_o2.save.lock_flag = *page_control->param_addr;
            SetSelectorValue (screen_id_temp, 38,g_sensor_o2.save.lock_flag);
        }
    }
}
