static void H_P_BasicSet(void)
{
    ;
}

static void H_O_BasicSet(PAGE_CONTROL *page_control)
{
    int u16val_temp = 0;
    uint16_t screen_id_temp = PAGE_BasicSet;

    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        sscanf ((const char*) page_control->param_addr, "%d", &u16val_temp);
        if (page_control->control_id == 16)
        {
            if (u16val_temp > g_hmi.save.light_low)
                g_hmi.save.light_upp = (uint16_t) u16val_temp;
            else
                App_Menu_Page_Sw (PAGE_Set_Error);
        }
        else if (page_control->control_id == 15)
        {
            if (u16val_temp < g_hmi.save.light_upp)
                g_hmi.save.light_low = (uint16_t) u16val_temp;
            else
                App_Menu_Page_Sw (PAGE_Set_Error);
        }
        else if (page_control->control_id == 8)
        {
            g_hmi.save.light_time = (uint16_t) u16val_temp;
        }
        SetAutoLight (1, g_hmi.save.light_upp, g_hmi.save.light_low, g_hmi.save.light_time);
    }

    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }
        else if (page_control->control_id == 9)
        {
            g_hmi.save.language = 0;
            SetLanguageToChinese ();
            AnimationPlayFrame (screen_id_temp, 3, 0);
            AnimationPlayFrame (screen_id_temp, 4, 1);
        }
        else if (page_control->control_id == 10)
        {
            g_hmi.save.language = 1;
            SetLanguageToEnglish ();
            AnimationPlayFrame (screen_id_temp, 3, 1);
            AnimationPlayFrame (screen_id_temp, 4, 0);
        }
    }
}

