/*
 * 功能：屏幕菜单运行函数，所有屏的控制，显示菜单都是这个函数
 * 输入：无
 * 输出：无
 * 返回：无
 */
void app_menu_Run(void)
{
    //取出屏指令并判断有无操作
    if (App_HMI_ReceiveData_Handle ()) //有操作将返回时间清除
    {
        g_menu.back_conter = 600;
    }

    g_hmi.para.flag_period_time_refresh++; //界面周期运行函数时间
    if (g_position_now >= 0) //栈位置  大于等于0 进入栈控制菜单
    {
        Historical_data_curve_display (); //历史趋势发送数据
        App_Display_Hmi_Menu (); //主界面和菜单页面运行函数
    }
    else
    {
        App_Display_Hmi_Non_Menu (); //主界面之前的界面
    }
    App_Get_Hmi_Time ();
}//主函数持续运行

