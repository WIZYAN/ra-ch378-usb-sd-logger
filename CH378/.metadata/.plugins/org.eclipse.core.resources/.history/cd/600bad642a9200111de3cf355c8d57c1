/*
 * 说明：判断输入的日是否合法
 * 输入：年月日
 * 输出：合法返回1 ，违法返回0
 */
static uint8_t isValidDay(uint16_t year, uint8_t month, uint8_t day)
{
    uint8_t isLeap = 0;
    uint8_t daysInMonth[] =
    { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };

    isLeap = ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0));
    if (month == 2)
    {
        daysInMonth[1] = isLeap ? 29 : 28;
    }

    return (day >= 1 && day <= daysInMonth[month - 1]) ? 1 : 0;
}
static void H_O_DataSave(PAGE_CONTROL *page_control)
{
    uint8_t daysInMonth[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
    int temp_val = 0;
    uint16_t year;
    uint8_t month;

    uint16_t screen_id_temp = PAGE_DataSave;
    year = g_hmi.para.hmi_set_time.year + 2000;
    month = g_hmi.para.hmi_set_time.month;
    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == PAGE_DataSave))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            g_hmi.para.flag_set_time = 0;
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            g_hmi.para.flag_set_time = 0;
            App_Return_Main_Dis ();
        }
        //查询
        else if (page_control->control_id == 13)
        {

            App_Menu_Page_Sw (PAGE_DataQuery);        //进入正在查询界面
        }
        //3.上一页
        else if (page_control->control_id == 8)
        {
            App_history_Data_Current_Dis (1, 0, 0);
        }
        //4.下一页
        else if (page_control->control_id == 9)
        {
            App_history_Data_Current_Dis (2, 0, 0);
        }
        else if (page_control->control_id == 29)        //U盘数据导出
        {
            if (g_usb_output.USB_link_flash_state == true)        //如果U盘处于连接状态
            {
                g_usb_output.usb_export_result = 0;
                g_usb_export_data.usb_export_flag = 1;
                menu_waiting = menu_usb_export;
                App_Menu_Page_Sw (PAGE_Waiting);
            }
            else
            {
                App_Menu_Page_Sw (PAGE_U_disk_Error);
            }
        }
    }
    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == PAGE_DataSave))
    {
        int value = 0;
        //1.存储周期-文本
        if (page_control->control_id == 1)
        {
            sscanf ((const char*) g_page.param_addr, "%2d", &temp_val);
            g_save_data_app.save.period_store = (uint8_t) temp_val;
        }
        //2.年-文本
        else if (page_control->control_id == 2)
        {
            sscanf ((const char*) g_page.param_addr, "%2d", &temp_val);
            g_hmi.para.hmi_set_time.year = (uint8_t) temp_val;
        }
        //3.月-文本
        else if (page_control->control_id == 3)
        {
            sscanf ((const char*) g_page.param_addr, "%2d", &temp_val);
            g_hmi.para.hmi_set_time.month = (uint8_t) temp_val;
        }
        //4.日-文本
        else if (page_control->control_id == 4)
        {
            sscanf ((const char*) g_page.param_addr, "%2d", &temp_val);
            if (isValidDay (year, month, (uint8_t) temp_val))
            {
                g_hmi.para.hmi_set_time.date = (uint8_t) temp_val;
            }
            else
            {
                if (month == 2)
                {
                    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0))
                    {
                        g_hmi.para.hmi_set_time.date = 29;
                    }
                    else
                    {
                        g_hmi.para.hmi_set_time.date = 28;
                    }
                }
                else
                {
                    g_hmi.para.hmi_set_time.date = daysInMonth[month - 1];
                }
                BatchBegin (screen_id_temp);
                BatchSetTextInt32 (4, (int32_t) g_hmi.para.hmi_set_time.date);
                BatchEnd ();
            }
        }
        //5.时-文本
        else if (page_control->control_id == 5)
        {
            sscanf ((const char*) g_page.param_addr, "%2d", &temp_val);
            g_hmi.para.hmi_set_time.hour = (uint8_t) temp_val;
        }
        else if (page_control->control_id == 27)        //USB存储周期时间设置
        {
            sscanf ((const char*) page_control->param_addr, "%d", &value);
            g_menu.save.usbtime_sec = (uint32_t)value;
        }

        //6.设置年、月、日和时
        if (page_control->control_id >= 2)
            g_hmi.para.flag_set_time = 1;
    }
