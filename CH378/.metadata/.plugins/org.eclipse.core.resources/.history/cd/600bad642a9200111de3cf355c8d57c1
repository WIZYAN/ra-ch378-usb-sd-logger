    uint16_t screen_id_temp = PAGE_BasicSet;

    BatchBegin (screen_id_temp);
    BatchSetTextInt32 (16, g_hmi.save.light_upp);
    BatchSetTextInt32 (15, g_hmi.save.light_low);
    BatchSetTextInt32 (8, g_hmi.save.light_time);
    if (g_hmi.save.language == 0) //中文
    {
        BatchSetFrame (3, 0);
        BatchSetFrame (4, 1);
