static void Permission_to_enter_the_interface(uint8_t Permission)    //根据不同权限进入不同的操作菜单
{
    //用户
    if (Permission == base_set)    //基本设置
        App_Menu_Page_Sw (PAGE_MainMenu);

    else if (Permission == user_set)    //用户设置
        App_Menu_Page_Sw (PAGE_Menu0124);

    else if (Permission == dis_limit)    //显示限制
    {
        App_Menu_Page_Sw (PAGE_Menu1028Page);
    }

    //用户管理员
    else if (Permission == user_manage)    //用户管理
        App_Menu_Page_Sw (PAGE_User_management);

    //工厂
    else if (Permission == cal_list)    //标定记录
        App_Menu_Page_Sw (PAGE_Menu0204);

    else if (Permission == fac_set)    //工厂设置  0303
        App_Menu_Page_Sw (PAGE_Menu0303);

    //试用功能
    else if (Permission == trial_func)
        App_Menu_Page_Sw (PAGE_Authority_Set);

    //输入输出设置
    else if (Permission == I_O_set)
    {
        App_Menu_Page_Sw (PAGE_InOutput);
    }
    //仪器信息
    else if (Permission == analyzer_info)
    {
        if (g_life.sensor.save.Verification_switch)    //开关
            App_Menu_Page_Sw (PAGE_Infor_certificate);
        else
            App_Menu_Page_Sw (PAGE_Infor);
    }
    else if (Permission == user_cal)    //标定
    {
        App_Menu_Page_Sw (PAGE_Menu0918_DoubleO2);
    }
    else if (Permission == fac_cal)    //工厂设置 0330
    {
        App_Menu_Page_Sw (PAGE_Menu0330_DoubleO2_Cal_Para);
    }
}

