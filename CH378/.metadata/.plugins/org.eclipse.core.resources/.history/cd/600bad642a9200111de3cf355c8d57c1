//主界面
/*
 * 名称：主界面周期性函数
 * 输入：无
 * 输出：无
 * 返回：无
 */
static void H_P_MainPage(void)
{
    uint16_t screen_id_temp;
    uint8_t temp_status;
    static uint8_t time_ref_main = 0 , flow_state = 0;    //不重要的信息不用每次更新

    screen_id_temp = PAGE_MainPage;
    if (g_life.main.para.limit_state_lock)
    {
        App_Menu_Page_Sw (PAGE_Trial_Hint);
    }
    else
    {
        time_ref_main++;
        if (time_ref_main % 3 == 0)    //约2s
        {
            BatchBegin (screen_id_temp);
            BatchSetTextFloat (1, (float) g_ms5607_data_air.i_Temperature / 100, 1);
            //吹扫/测试
            BatchSetFrame (34 , g_sensor_o2.data_para.val_1_sta);
            if (g_hmi.para.status_main_page)
                temp_status = 1;
            else
                temp_status = 0;
            BatchSetFrame (17, temp_status);    //状态报警
            if (g_alarm[0].run_para.ala_sta)
                temp_status = 1;
            else
                temp_status = 0;
            BatchSetFrame (16, temp_status);    //浓度报警1
            if (g_alarm[1].run_para.ala_sta)
                temp_status = 1;
            else
                temp_status = 0;
            BatchSetFrame (13, temp_status);    //浓度报警2
            BatchEnd ();
            //状态

            SetSelectorValue (screen_id_temp, 33, g_sensor_o2.data_para.val_1_sta);
            SetSelectorValue (screen_id_temp, 21, g_hmi.para.status_main_page);
            SetSelectorValue (screen_id_temp, 4, g_alarm[0].run_para.ala_sta);
            SetSelectorValue (screen_id_temp, 8, g_alarm[1].run_para.ala_sta);

            //用户名显示
            BatchBegin (screen_id_temp);
            if (g_user_manage.save.rember_password_sw)
            {
                BatchSetText (26, name_temp);
            }
            else
            {
                BatchSetText (26, (uint8_t*) "   \0");
            }
            BatchEnd ();
        }

        if((g_var_temp.alarm_class + 0)->alarm_selection  == 4)//隐藏报警1
        {
            SetControlVisiable (screen_id_temp, 16, 0);           //隐藏
            SetControlVisiable (screen_id_temp, 4000, 0);         //隐藏
            SetControlVisiable (screen_id_temp, 4, 0);            //隐藏
        }
        else
        {
            SetControlVisiable (screen_id_temp, 16, 1);
            SetControlVisiable (screen_id_temp, 4000, 1);
            SetControlVisiable (screen_id_temp, 4, 1);
        }
        if((g_var_temp.alarm_class + 1)->alarm_selection  == 4)//隐藏报警2
        {
            SetControlVisiable (screen_id_temp, 13, 0);
            SetControlVisiable (screen_id_temp, 4001, 0);
            SetControlVisiable (screen_id_temp, 8, 0);            //隐藏
        }
        else
        {
            SetControlVisiable (screen_id_temp, 13, 1);
            SetControlVisiable (screen_id_temp, 4001, 1);
            SetControlVisiable (screen_id_temp, 8, 1);            //隐藏
        }

        SetTextValueFloat (screen_id_temp, 10, g_flow.para.flow_curr / 1000, 1);//流量显示

        if (ND_DIS_Change_Micro_ppm (screen_id_temp, 3, (*g_var_temp.sensor.pointer_user_dis_tent)) == 2)     //浓度更新显示判断
        {
            AnimationPlayFrame (screen_id_temp, 2, 1);            //o2 %
        }
        else if (ND_DIS_Change_Micro_ppm (screen_id_temp, 3, (*g_var_temp.sensor.pointer_user_dis_tent)) == 1)
        {
            AnimationPlayFrame (screen_id_temp, 2, 0);            //o2 ppm
        }
    }

    if(flow_state != g_flow.para.flow_control_err)
    {
        if(flow_state == 0)
        {
            App_Menu_Page_Sw(PAGE_control_flow_upper);
        }
        flow_state = g_flow.para.flow_control_err;
    }
}

