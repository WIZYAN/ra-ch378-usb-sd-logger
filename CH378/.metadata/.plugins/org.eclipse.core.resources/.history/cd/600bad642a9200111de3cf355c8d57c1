static void H_P_AnalogOutPut12(void)
{
    ;
}

static void H_O_AnalogOutPut12(PAGE_CONTROL *page_control)
{
    double fval_temp = 0;
    int u32val_temp = 0;
    uint16_t screen_id_temp = PAGE_AnalogOutPut12;
    uint16_t id = page_control->control_id;

    if ((page_control->control_type == kCtrlText) && (page_control->screen_id == screen_id_temp))
    {
        fval_temp = (double) atof ((const char*) page_control->param_addr);
        fval_temp *= g_var_temp.val_multi;
        u32val_temp = (int32_t) fval_temp;

        if (id == 26)
        {
            if (u32val_temp > (*g_var_temp.analog.pointer_low1) && u32val_temp <= g_var_temp.val_limit_upp && u32val_temp >= 0)
            {
                *g_var_temp.analog.pointer_upp1 = u32val_temp;
            }
            else
            {
                App_Menu_Page_Sw (PAGE_Set_Error);
            }
        }
        else if (page_control->control_id == 27)
        {
            if (u32val_temp < (*g_var_temp.analog.pointer_upp1) && u32val_temp >= g_var_temp.val_limit_low && u32val_temp >=0)
            {
                *g_var_temp.analog.pointer_low1 = u32val_temp;
            }
            else
            {
                App_Menu_Page_Sw (PAGE_Set_Error);
            }
        }

        BatchBegin (screen_id_temp);
        BatchSetTextDouble (26, (double) *g_var_temp.analog.pointer_upp1 / g_var_temp.val_multi,g_var_temp.val_digits);
        BatchSetTextDouble (27, (double) *g_var_temp.analog.pointer_low1 / g_var_temp.val_multi,g_var_temp.val_digits);
        BatchEnd ();
    }
    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
             App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }
    }
}


