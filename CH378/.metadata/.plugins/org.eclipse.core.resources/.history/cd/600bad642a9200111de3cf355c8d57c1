static void H_O_FlowSet(PAGE_CONTROL *page_control)
{
    uint16_t screen_id_temp = PAGE_FlowSet;
    float temp_val = 0;
    if ((page_control->control_type == kCtrlButton) && (page_control->screen_id == screen_id_temp))
    {
        if (page_control->control_id == BUTTON_RETURN)
        {
            App_Menu_Page_Back ();
        }
        else if (page_control->control_id == BUTTON_MAIN)
        {
            App_Return_Main_Dis ();
        }
        else if (page_control->control_id == 59)//开度值加减
        {
            g_flow.save.ctr_valve_opening = g_flow.save.ctr_valve_opening + 1;
            if( g_flow.save.ctr_valve_opening >= 100)
            {
                g_flow.save.ctr_valve_opening = 100;
            }
            g_flow.para.Regulating_flow_mark = 0;
            g_flow.para.flow_flag = 1;
            g_pressure.pressure_over_sta = 0;
            g_flow.para.allow_atuo_flow = 0;    //手动调整开度后 智能控制临时禁止
        }
        else if (page_control->control_id == 60)
        {
            g_flow.save.ctr_valve_opening = g_flow.save.ctr_valve_opening - 1;
            if(g_flow.save.ctr_valve_opening <= 0)
            {
                g_flow.save.ctr_valve_opening = 0;
            }
            g_flow.para.Regulating_flow_mark = 0;
            g_flow.para.flow_flag = 1;
            g_pressure.pressure_over_sta = 0;
            g_flow.para.allow_atuo_flow = 0;    //手动调整开度后 智能控制临时禁止
        }
    }
    else if ((page_control->control_type == kCtrlText) && (page_control->screen_id == PAGE_FlowSet))
    {
        temp_val = (float) atof ((const char*) page_control->param_addr);
        if (page_control->control_id == 1) //流量设置值
        {
            g_flow.save.control_flow = temp_val * 1000 ;
            g_flow.para.Regulating_flow_mark = 1;
            g_pressure.pressure_over_sta = 0;
            g_flow.para.allow_atuo_flow = 1;    //设置控制流量值后，智能控制流量被打开
        }
        else if(page_control->control_id == 4)//开度值设置
        {
            if((int)(temp_val * 1000) == 0)
                g_flow.save.ctr_valve_opening = -1;//全关
            else
                g_flow.save.ctr_valve_opening = (int)(temp_val);
            g_flow.para.Regulating_flow_mark = 0;
            g_pressure.pressure_over_sta = 0;
            g_flow.para.flow_flag = 1;
            g_flow.para.allow_atuo_flow = 0;    //手动调整开度后 智能控制临时禁止
        }
    }
}


