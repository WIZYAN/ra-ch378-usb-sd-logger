/*
 * 说明：整机运行时间处理函数  放在1s定时器运行
 * 输入：无
 * 输出：无
 */
void run_runtime(void)
{
    static uint32_t temp_time = 0, trail_time = 0;

    temp_time++;
    if (temp_time >= 3600)
    {
        temp_time = 0;
        g_menu.runtime++;
        g_flash_var.save_flag.Bits.write_time = 1;
    }
    if (g_life.main.save.main_password_lock_switch)
    {
        trail_time++;
        if (trail_time >= 3600)
        {
            trail_time = 0;
            g_life.main.para.one_hour_flag = 1;
        }
    }
}

/*
 * 说明：5分钟未操作界面，自动退出到主界面  放在1s定时器运行
 * 输入：无
 * 输出：无
 */
void run_back_main_dis(void)
{
    if ((g_stack[g_position_now - 1] == PAGE_Menu0918_DoubleO2))
    {
        g_menu.back_conter = 600;
    }
    else
    {
        if (g_menu.back_conter && g_position_now != 0 && g_stack[0] != 0) //计时不为0 ，栈位置和值不为0，表示进入菜单
        {
            g_menu.back_conter--;
            if (g_menu.back_conter == 0)
                App_Return_Main_Dis ();
        }
    }
}

