        }
        else if (page_control->control_id == 14)
        {
            if(fvalue > -1000000 && fvalue < 1000000)
            {
                (*g_var_temp.user_dis.pointer_amend) =  fvalue;
            }
            else
            {
                App_Menu_Page_Sw (PAGE_Set_Error);
            }
        }

       // H_F_Menu1028Page ();
