//等待界面
uint16_t Waiting_time, Waiting_time_count;
static void H_F_Waiting(void)
{
    uint16_t screen_id_temp = PAGE_Waiting;

    if (menu_waiting == menu_flow_cal)
        Waiting_time = 10;    //5s
    else if (menu_waiting == menu_formating)
        Waiting_time = 3;    //40s
    else if (menu_waiting == menu_format_conc_record)
        Waiting_time = 3;    //40s
    else if (menu_waiting == menu_format_pre_record)
        Waiting_time = 3;    //40s
    else if (menu_waiting == menu_format_temp_record)
        Waiting_time = 3;    //40s
    else if (menu_waiting == menu_format_all_record)
        Waiting_time = 3;    //40s
    else if (menu_waiting == menu_ref_set)    //恢复设置
        Waiting_time = 7;
    else if (menu_waiting == menu_internet_set)
        Waiting_time = 20;    //5s
    else if (menu_waiting == menu_cal_micro)
        Waiting_time = 10;    //5s
    else if (menu_waiting == menu_flow_set)
        Waiting_time = 20;    //3min
    else if (menu_waiting == menu_flow_ctrl)
        Waiting_time = 5;    //20s
    else if (menu_waiting == menu_work_doubleo2)    //双氧传感器-工作设置界面
        Waiting_time = 5;
    else if(menu_waiting == menu_usb_export)
        Waiting_time = 5;
    else if(menu_waiting == menu_flow_close)
        Waiting_time = 5;
    else if(menu_waiting == menu_flow_open)
        Waiting_time = 5;
    else if(menu_waiting == menu_flow_cur_cail)
        Waiting_time = 5;
    else if(menu_waiting == menu_valve_cal)
        Waiting_time = 5;

    ///工作设置界面
    if (menu_waiting == menu_work_doubleo2)
    {
        if (temp_doubleo2_ctrl.sw_ppm_upp <= temp_doubleo2_ctrl.sw_ppm_low)
        {
            temp_doubleo2_ctrl.res_set = 1;
        }
        else
        {
            vTaskDelay (50);
        }
    }
    SetScreen (screen_id_temp);
}

static void H_P_Waiting(void)
{
    menu_delay(50);//延时
    if(Waiting_time)
        Waiting_time--;

    if(Waiting_time == 0)//等待时间到达
    {
        if(menu_waiting == menu_flow_cal)//在流量标定页面触发等待页面
        {
            App_Menu_Page_Sw(PAGE_FlowADJ_res);//切换到流量标定结果
        }
        else if(menu_waiting == menu_formating)
        {
            App_Format_Data(8);//格式化存储
            App_Menu_Page_Sw(PAGE_Successfully);//切换到格式化完成
        }
        else if(menu_waiting == menu_format_all_record)
        {
            App_Format_Data(7);//格式化存储
            App_Menu_Page_Sw(PAGE_Successfully);//切换到格式化完成
        }
        else if(menu_waiting == menu_ref_set)//恢复设置
        {
            App_Menu_Page_Sw(PAGE_RecoverResult);//读取所有参数
        }
        else if(menu_waiting == menu_internet_set)//网络设置
        {
            App_Menu_Page_Sw(PAGE_Successfully);
        }
        else if(menu_waiting == menu_flow_set)
        {
            App_Menu_Page_Back_Twice();
        }
        else if(menu_waiting == menu_usb_export)//数据存储界面
        {
            if(g_usb_export_data.usb_export_flag == 0 )//导出操作标志  0 完成 1开始
            {
                if(g_usb_output.usb_export_result == -1)//失败
                {
                    App_Menu_Page_Sw(PAGE_Set_Error);
                }
                else
                {
                    App_Menu_Page_Sw(PAGE_Successfully);
                }
            }
        }

        if(menu_waiting == menu_cal_micro)
        {
            App_Menu_Page_Sw(PAGE_CalRes_DoubleO2);//切换到标定结果
        }
    }
}
