/*
 * 说明：数据取出最大值函数--此处为11个数据进行比较--曲线界面
 * 输入：要比较的数据
 * 输出：当前的最大数据
 */
float arry_max1_his[13] =
{ -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200 };
float arry_min1_his[13] =
{ 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000 };
static void his_sorting_function(float max_data, float min_data)
{
    float max = 0, min = 0;
    uint8_t i;

    for (i = 0; i < 11; i++)
    {
        arry_max1_his[i] = arry_max1_his[i + 1];
        arry_min1_his[i] = arry_min1_his[i + 1];
    }

    arry_max1_his[11] = max_data;
    arry_min1_his[11] = min_data;

    for (i = 0; i < 12; i++)
    {
        if (arry_max1_his[i] > max)
        {
            max = arry_max1_his[i];
        }

        if (arry_min1_his[i] < min)
        {
            min = arry_min1_his[i];
        }
    }

    arry_max1_his[12] = max;  //数组的12号元素存的为此数组的最大值
    arry_min1_his[12] = min;
}

/*
 * 说明：数据取出最大值函数--此处为11个数据进行比较--主显示
 * 输入：要比较的数据
 * 输出：当前的最大数据
 */
float arry_max1_main[13] =
{ -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200, -200 };
float arry_min1_main[13] =
{ 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000, 1000000 };
static void main_sorting_function(float max_data, float min_data)
{
    float max = 0, min = 0;
    uint8_t i;

    for (i = 0; i < 11; i++)
    {
        arry_max1_main[i] = arry_max1_main[i + 1];
        arry_min1_main[i] = arry_min1_main[i + 1];
    }

    arry_max1_main[11] = max_data;
    arry_min1_main[11] = min_data;

    for (i = 0; i < 12; i++)
    {
        if (arry_max1_main[i] > max)
        {
            max = arry_max1_main[i];
        }

        if (arry_min1_main[i] < min)
        {
            min = arry_min1_main[i];
        }
    }

    arry_max1_main[12] = max;
    arry_min1_main[12] = min;
}

/*
 * 说明历史数据的曲线显示，包含主界面和趋势显示界面  放在菜单运行函数运行  20ms   5s写入一个数据  自适应纵坐标
 * 输入：无
 * 输出：无
 */
static void Historical_data_curve_display(void)
{
    float dis_value;
    static float temp_dis_upp_main = 0, temp_dis_low_main = 0, temp_divide_main, curr_dis_upp_main = -200,
            curr_dis_low_main = 1000000;
    static float temp_dis_upp_his = 0, temp_dis_low_his = 0, temp_divide_his, curr_dis_upp_his = -200,
            curr_dis_low_his = 1000000;
    static uint32_t point_temp_main, point_temp_his;  //点计数

//主界面显示浓度值
    dis_value = (*g_var_temp.sensor.pointer_user_dis_tent);

//取极值
    if (dis_value > curr_dis_upp_main)
    {
        curr_dis_upp_main = dis_value;
    }
    if (dis_value < curr_dis_low_main)
    {
        curr_dis_low_main = dis_value;
    }
    if (dis_value > curr_dis_upp_his)
    {
        curr_dis_upp_his = dis_value;
    }
    if (dis_value < curr_dis_low_his)
    {
        curr_dis_low_his = dis_value;
    }

//取本屏和上次屏的最大值 最小值
    if (arry_max1_main[12] >= curr_dis_upp_main)
        temp_dis_upp_main = arry_max1_main[12];
    else
        temp_dis_upp_main = curr_dis_upp_main;

    if (arry_min1_main[12] <= curr_dis_low_main)
        temp_dis_low_main = arry_min1_main[12];
    else
        temp_dis_low_main = curr_dis_low_main;

    if (arry_max1_his[12] >= curr_dis_upp_his)
        temp_dis_upp_his = arry_max1_his[12];
    else
        temp_dis_upp_his = curr_dis_upp_his;
    if (arry_min1_his[12] <= curr_dis_low_his)
        temp_dis_low_his = arry_min1_his[12];
    else
        temp_dis_low_his = curr_dis_low_his;

//等分后跳转曲线最大最小值
    temp_divide_main = (temp_dis_upp_main - temp_dis_low_main) / 8;  //等分8分
    temp_divide_his = (temp_dis_upp_his - temp_dis_low_his) / 8;  //等分8分
    g_hmi.para.flag_Historical_curve_refresh++;
    if (g_hmi.para.flag_Historical_curve_refresh > 250)  //5s写入一组曲线数据--250
    {
        HistoryGraph_Data_Dis (PAGE_TendencyChart, 1, (uint8_t*) &dis_value);
        Historical_curve_range (PAGE_TendencyChart, 1, (int) (temp_dis_upp_his + temp_divide_his + 1),
                                (int) (temp_dis_low_his - temp_divide_his - 1));  //显示坐标纵坐标范围

        HistoryGraph_Data_Dis (PAGE_MainPage, 12, (uint8_t*) &dis_value);
        Historical_curve_range (PAGE_MainPage, 12, (int) (temp_dis_upp_main + temp_divide_main + 1),
                                (int) (temp_dis_low_main - temp_divide_main - 1));  //显示坐标纵坐标范围

        g_hmi.para.flag_Historical_curve_refresh = 0;

        //点数记录判断
        point_temp_main++;
        if (point_temp_main > 72)  //720是曲线的最大点数
        {
            point_temp_main = 0;
            main_sorting_function (curr_dis_upp_main, curr_dis_low_main);
            curr_dis_upp_main = -200;
            curr_dis_low_main = 1000000;
        }

        point_temp_his++;
        if (point_temp_his > 820)  //8192是曲线的最大点数
        {
            point_temp_his = 0;
            his_sorting_function (curr_dis_upp_his, curr_dis_low_his);
            curr_dis_upp_his = -200;
            curr_dis_low_his = 1000000;
        }
    }
}

