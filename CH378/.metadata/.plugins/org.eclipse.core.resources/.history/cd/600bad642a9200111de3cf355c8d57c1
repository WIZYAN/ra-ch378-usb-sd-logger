/*
 * 功能：触摸屏非菜单显示函数  用于不在菜单的界面
 * 输入：无
 * 输出：无
 */
static void App_Display_Hmi_Non_Menu(void)
{
    int16_t page_id_now;               //当前页面
    //1.将屏幕ID进行实时更新
    page_id_now = g_position_now;

    //2.若上一次的界面ID与本次界面ID不同，则运行本次界面ID的首次运行函数
    if (page_id_last != page_id_now)    //上次的栈值不等于最新栈值（界面切换了）则运行首次函数  栈里面保存的是页面
    {
        //1、首次运行函数
        if (page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_f != NULL)
            page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_f ();
    }
    else    //等于则运行周期函数和控件处理函数
    {
        //2.周期函数（函数不为空&&周期性运行时间：500ms）
        if ((page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_p != NULL)
                && g_hmi.para.flag_period_time_refresh > 12)
        {
            page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_p ();
            g_hmi.para.flag_period_time_refresh = 0;
        }
        //3.指令操作函数
        if (g_page.cmd_type != 0)
        {
            if (page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_o != NULL)
                page_non_menu_fun_run[page_id_now + MAX_NON_MENU_PAGE].f_o (&g_page);
            g_page.cmd_type = 0;
        }
    }

    page_id_last = page_id_now;
}

/*
 * 功能：用于触摸屏菜单显示的界面
 * 输入：无
 * 输出：无
 */
static void App_Display_Hmi_Menu(void)
{
    int16_t page_id_now = 0, temp_position;

    //1.将屏幕ID进行实时更新
    temp_position = g_position_now - 1;
    if (temp_position < 0)
        temp_position = 0;
    page_id_now = g_stack[temp_position] - MAX_NON_MENU_PAGE; //减去非主界面的页面数
    if (page_id_now < 0)
        page_id_now = 0;

    //2.若上一次的界面ID与本次界面ID不同，则运行本次界面ID的首次运行函数
    if (page_id_last != page_id_now) //上次的栈值不等于最新栈值（界面切换了）则运行首次函数  栈里面保存的是页面
    {
        //1、首次运行函数
        if (page_fun_run[page_id_now].f_f != NULL)
            page_fun_run[page_id_now].f_f ();
    }
    else //等于则运行周期函数和控件处理函数
    {
        //2.周期函数（函数不为空&&周期性运行时间：500ms）
        if ((page_fun_run[page_id_now].f_p != NULL) && g_hmi.para.flag_period_time_refresh > 15) //g_hmi.para.flag_period_time_refresh 用于控制周期函数多就运行一次
        {
            page_fun_run[page_id_now].f_p ();
            g_hmi.para.flag_period_time_refresh = 0;
        }

        //3.指令操作函数
        if (g_page.cmd_type != 0)
        {
            if (page_fun_run[page_id_now].f_o != NULL)
                page_fun_run[page_id_now].f_o (&g_page);
            g_page.cmd_type = 0;
        }
    }

    page_id_last = page_id_now;
}

